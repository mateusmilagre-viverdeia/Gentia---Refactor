# ============================================================================
# .env.example — Inventário de variáveis/secrets do projeto Gentia/culturecode
# ----------------------------------------------------------------------------
# Copie para `.env` e preencha. O `.env` está no .gitignore — NUNCA versione valores.
# Os secrets de Edge Functions (seção 3) vão no painel do Supabase de DESTINO
# (Settings → Edge Functions → Secrets), NÃO neste arquivo de frontend.
# ============================================================================

# ----------------------------------------------------------------------------
# 1) FRONTEND (Vite) — vão no `.env` local e no build
#    Onde pegar (Supabase DESTINO): Settings → API
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=                 # ex: https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=     # a chave "anon"/"publishable" (pode ir pro front)
VITE_SUPABASE_PROJECT_ID=          # o project ref (ex: abcdefgh...)
# Domínio público canônico do app (links compartilháveis + redirect de rotas públicas).
# DEIXE VAZIO durante os testes no domínio do Lovable (os links usam o domínio atual).
# Defina como https://gentia.tech SÓ quando o domínio de produção estiver no ar.
VITE_PUBLIC_ORIGIN=                 # ex: https://gentia.tech (vazio = usa a URL atual)

# ----------------------------------------------------------------------------
# 2) SUPABASE — INJETADOS AUTOMATICAMENTE nas Edge Functions (NÃO setar à mão)
#    Listados só para referência da migração.
# ----------------------------------------------------------------------------
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_DB_URL

# ----------------------------------------------------------------------------
# 3) SECRETS DE EDGE FUNCTIONS — setar no painel do Supabase de DESTINO
#    (Settings → Edge Functions → Secrets) ou via `supabase secrets set`.
# ----------------------------------------------------------------------------

# --- IA / LLM ---
LOVABLE_API_KEY=          # ⚠️ Gateway do Lovable — SOME fora do Lovable Cloud. Migrar p/ provedor direto.
OPENAI_API_KEY=           # OpenAI (GPT-5, Realtime/voz, embeddings)
ANTHROPIC_API_KEY=        # NOVO — alternativa Claude (foco da auditoria de custos)
GEMINI_API_KEY=           # Google Gemini (se for chamar direto, sem o gateway Lovable)

# --- Pagamentos (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- WhatsApp (Z-API / Twilio) ---
ZAPI_TOKEN=
ZAPI_INSTANCE_ID=
ZAPI_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Sourcing / Enriquecimento de candidatos ---
FIRECRAWL_API_KEY=
APOLLO_API_KEY=
APIFY_API_TOKEN=          # (algumas functions usam APIFY_TOKEN — padronizar na migração)
CLEARBIT_API_KEY=
HUNTER_API_KEY=
EVABOOT_API_KEY=
NEVERBOUNCE_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
STACKEXCHANGE_KEY=
GITHUB_TOKEN=

# --- Vídeo / Mídia ---
PANDA_VIDEO_API_KEY=

# --- Integrações diversas ---
DISCORD_WEBHOOK_URL=
GOOGLE_INDEXING_SERVICE_ACCOUNT=   # JSON da service account (Google Indexing API)

# --- Operacional / URLs ---
CRON_SECRET=              # protege endpoints de cron (verify_jwt=false)
SITE_URL=
PUBLIC_SITE_URL=
FRONTEND_URL=
ENVIRONMENT=             # ex: production | staging
